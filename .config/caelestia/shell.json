{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "background": {
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": false,
            "inverted": true,
            "showOnHover": false
        },
        "clock": {
            "background": true,
            "showDate": true,
            "showSeconds": false
        },
        "dragThreshold": 20,
        "popouts": {
            "activeWindow": false
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "occupiedBg": false,
            "showUnoccupied": true,
            "showWindows": true,
            "showWindowsOnSpecialWorkspaces": true,
            "shown": 5
        }
    },
    "general": {
        "apps": {
            "explorer": [
                "nautilus",
                "--new-window"
            ]
        }
    },
    "services": {
        "brightnessIncrement": 0.05,
        "clockFormat": "TwelveHour",
        "maxVolume": 1,
        "sensorUnits": "Celsius"
    }
}
